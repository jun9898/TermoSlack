# TermoSlack supports two ways to authenticate. Pick one.
#
# 1) Session-only mode (no Slack app required)
#    Fill in SLACK_XOXC + SLACK_XOXD below and leave the OAuth block empty.
#    TermoSlack talks to Slack as your browser does, so every feature works
#    without installing an app or asking an admin for approval.
#
# 2) OAuth mode
#    Create a Slack app and fill in SLACK_CLIENT_ID + SLACK_CLIENT_SECRET.
#
# When both are present, a saved OAuth session wins; session credentials are
# used only if no OAuth session exists yet.

# Browser session credentials (required for session-only mode)
# Also used for the private sidebar-sections and unread-count APIs in both modes.
# How to get them in the Slack web client:
#   SLACK_XOXC -> DevTools Console: JSON.parse(localStorage.localConfig_v2).teams[Object.keys(JSON.parse(localStorage.localConfig_v2).teams)[0]].token
#   SLACK_XOXD -> DevTools > Application > Cookies > https://app.slack.com > value of the "d" cookie
# Treat both as passwords: they grant full access to your Slack account.
SLACK_XOXC=
SLACK_XOXD=

# Slack OAuth Credentials (optional — only needed for OAuth mode)
# Get these from: https://api.slack.com/apps -> Your App -> Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# OAuth Settings (only used in OAuth mode)
OAUTH_PORT=3000
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# User Scopes (comma-separated, automatically requested during OAuth)
# These scopes allow the app to act as the authenticated user
OAUTH_USER_SCOPES=channels:read,channels:write,channels:history,chat:write,users:read,groups:read,groups:write,groups:history,mpim:read,mpim:write,mpim:history,im:read,im:write,im:history,files:read,files:write,reactions:read,reactions:write,search:read,emoji:read
